          contract: {
            id: "GET /api/rates"
            json: "{\"operationId\":\"56d2fdecaee833415819830b15ab7d8c\",\"parameters\":[{\"description\":\"Base currency (only EUR supported)\",\"example\":\"EUR\",\"in\":\"query\",\"name\":\"from\",\"required\":true,\"schema\":{\"example\":\"EUR\",\"type\":\"string\"}},{\"description\":\"Target currency or comma-separated list of currencies\",\"example\":\"HKD,GBP,USD\",\"in\":\"query\",\"name\":\"to\",\"required\":true,\"schema\":{\"example\":\"HKD,GBP,USD\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"oneOf\":[{\"properties\":{\"from\":{\"example\":\"EUR\",\"type\":\"string\"},\"rates\":{\"properties\":{\"GBP\":{\"properties\":{\"date\":{\"example\":\"2025-06-26\",\"type\":\"string\"},\"rate\":{\"example\":9.1803,\"type\":\"number\"}},\"type\":\"object\"},\"HKD\":{\"properties\":{\"date\":{\"example\":\"2025-06-26\",\"type\":\"string\"},\"rate\":{\"example\":0.8535,\"type\":\"number\"}},\"type\":\"object\"},\"USD\":{\"properties\":{\"date\":{\"example\":\"2025-06-26\",\"type\":\"string\"},\"rate\":{\"example\":1.1695,\"type\":\"number\"}},\"type\":\"object\"}},\"type\":\"object\"},\"source\":{\"example\":\"European Central Bank (ECB)\",\"type\":\"string\"}},\"type\":\"object\"},{\"properties\":{\"date\":{\"example\":\"2025-06-26\",\"type\":\"string\"},\"from\":{\"example\":\"EUR\",\"type\":\"string\"},\"rate\":{\"example\":1.0895,\"type\":\"number\"},\"source\":{\"example\":\"European Central Bank (ECB)\",\"type\":\"string\"},\"to\":{\"example\":\"USD\",\"type\":\"string\"}},\"type\":\"object\"}]}}},\"description\":\"Successful response. Returns either a single currency rate or multiple currency rates.\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"oneOf\":[{\"properties\":{\"error\":{\"example\":\"Invalid or missing parameters\",\"type\":\"string\"}},\"type\":\"object\"},{\"properties\":{\"error\":{\"example\":\"Only EUR as base currency is supported by the ECB\",\"type\":\"string\"}},\"type\":\"object\"}]}}},\"description\":\"Bad Request\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{}}},\"description\":\"No data\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/api/rates"
          segments: [
