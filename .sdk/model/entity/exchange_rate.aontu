# Entity: exchange_rate

main: kit: entity: exchange_rate: {

  alias: field: {}

  name: "exchange_rate"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/rates"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "EUR"
                k: "query"
                n: "from"
                or: "from"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "HKD,GBP,USD"
                k: "query"
                n: "to"
                or: "to"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/rates"
          q: {
            exist: [
              "from"
              "to"
            ]
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "rates"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  fields: {
  }



}
